# Launch NAP — override CMS Brand Settings in production (see docs/LAUNCH_FACTS.md)
# JARKABI_PRIMARY_PHONE=(613) 555-0100
# JARKABI_TOLL_FREE_PHONE=1-888-555-0100
# JARKABI_OTTAWA_OFFICE_ADDRESS=123 Example St, Ottawa, ON K1A 0A1
# JARKABI_BUSINESS_HOURS=Mon–Fri: 8:00 AM – 6:00 PM · Sat: 9:00 AM – 2:00 PM

# Photography — set true only to show the staging disclosure banner again
# NEXT_PUBLIC_PHOTOS_STAGING=true

# Database — local dev uses SQLite (see payload.config.ts fallback).
# Production: Supabase Postgres in Canada (Central) — same pattern as ketet.org.
# Create a NEW Supabase project (do not share Ketet's database).
# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543)
# DATABASE_URI=postgresql://postgres.[project-ref]:[password]@aws-0-ca-central-1.pooler.supabase.com:6543/postgres
DATABASE_URI=file:./payload.db

# Payload CMS
PAYLOAD_SECRET=replace-with-a-long-random-secret-min-32-chars
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Vercel Blob (auto-set when Blob storage is added in Vercel dashboard)
# BLOB_READ_WRITE_TOKEN=

# Email (configure before production)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CARE_INQUIRY_EMAIL=care@jarkabi.ca

# Capacitor mobile wrapper (optional)
# CAPACITOR_SERVER_URL=https://jarkabi.ca

# Analytics (optional — privacy-conscious)
# ANALYTICS_ID=

# Supabase Auth + portal (Canada Central — separate from Payload DATABASE_URI)
# NEXT_PUBLIC_SUPABASE_URL=https://[project-ref].supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Local portal preview without Supabase Auth (never enable in production)
# NEXT_PUBLIC_PORTAL_DEMO=true

# Maintenance mode — redirects public traffic to /maintenance
# MAINTENANCE_MODE=true
